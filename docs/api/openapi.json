  "info": {
    "title": "Player Prop API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/edges": {
      "get": {
        "description": "List computed betting edges (sportsbook line vs. model projection).\n\nRows come from prop_edges, produced by build_prop_edges.py. Each row is one\n(event, market, player, bookmaker, line) with the model's projection, the\nraw edge, win probability, recommended side, and edge tier.",
        "operationId": "list_edges_api_v1_edges_get",
        "parameters": [
          {
            "description": "Filter to one market, e.g. rec_yds",
            "in": "query",
            "name": "market_code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter to one market, e.g. rec_yds",
              "title": "Market Code"
            }
          },
          {
            "description": "Minimum edge tier: small|medium|strong|elite",
            "in": "query",
            "name": "min_tier",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum edge tier: small|medium|strong|elite",
              "title": "Min Tier"
            }
          },
          {
            "description": "Filter by recommended side: over|under",
            "in": "query",
            "name": "side",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by recommended side: over|under",
              "title": "Side"
            }
          },
          {
            "description": "Case-insensitive player name search",
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive player name search",
              "title": "Search"
            }
          },
          {
            "description": "Only games that have not kicked off yet. The dashboard is for deciding what to bet, so past slates are hidden by default; pass false to browse historical edges.",
            "in": "query",
            "name": "upcoming_only",
            "required": false,
            "schema": {
              "default": true,
              "description": "Only games that have not kicked off yet. The dashboard is for deciding what to bet, so past slates are hidden by default; pass false to browse historical edges.",
              "title": "Upcoming Only",
              "type": "boolean"
            }
          },
          {
            "description": "Sort key: edge|win_prob|line|projection|commence_time|player_name",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "edge",
              "description": "Sort key: edge|win_prob|line|projection|commence_time|player_name",
              "title": "Sort",
              "type": "string"
            }
          },
          {
            "description": "asc|desc",
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "default": "desc",
              "description": "asc|desc",
              "title": "Order",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Edges",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/edges/summary": {
      "get": {
        "description": "Aggregate stats for the dashboard header: counts per market and per tier.",
        "operationId": "edges_summary_api_v1_edges_summary_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Edges Summary",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/jobs/attach_labels": {
      "post": {
        "description": "Fill in `label_actual` for rows whose target game has since been played.\n\nMatches `player_market_features` rows to `player_game_stats_app` on\n(player_id, as_of_game_date, opponent, market_id) and copies the real\nstat value. Run this after a game week completes and before retraining.",
        "operationId": "attach_labels_api_v1_jobs_attach_labels_post",
        "parameters": [
          {
            "in": "query",
            "name": "market_code",
            "required": true,
            "schema": {
              "title": "Market Code",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Attach Labels",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/jobs/build_features": {
      "post": {
        "description": "Compute rolling + contextual features for one market and upsert them.\n\nFor every eligible-position player/game, builds features from a strictly\nprior lookback window (never the target game itself): base rolling stats\n(mean/stddev/weighted_mean/trend), market-specific engineered ratios\n(target share, yards per target/carry/attempt, opponent defensive rates),\nrolling snap share, nflverse's `ff_opportunity` expected-usage model, and\nthe *current* game's pre-game Vegas/weather/injury context (not averaged\nover the window -- see the \"Pre-game Vegas context\" comment below for why\nthat's legitimate, not leakage). Writes to `player_market_features`.\n\nSee docs/ML_PIPELINE.md for the full feature list and rationale.",
        "operationId": "build_features_api_v1_jobs_build_features_post",
        "parameters": [
          {
            "in": "query",
            "name": "market_code",
            "required": true,
            "schema": {
              "title": "Market Code",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "lookback",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 50,
              "minimum": 1,
              "title": "Lookback",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Build Features",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/odds/sync/events": {
      "post": {
        "operationId": "sync_odds_events_api_v1_odds_sync_events_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Sync Odds Events"
      }
    },
    "/api/v1/odds/sync/player_props": {
      "post": {
        "description": "Pull player props for events kicking off within the next `days_ahead` days.\n\nThe Odds API bills player props per event per market, so this is deliberately\nscoped to the upcoming slate rather than every row in `odds_events`. A full\nseason sync is ~272 events x ~8 markets, which would burn thousands of credits\nin a single call and mostly fetch lines for games that are not priced yet.\nWiden `days_ahead` or set `limit` explicitly when a bigger pull is intended.",
        "operationId": "sync_odds_player_props_api_v1_odds_sync_player_props_post",
        "parameters": [
          {
            "in": "query",
            "name": "days_ahead",
            "required": false,
            "schema": {
              "default": 8,
              "title": "Days Ahead",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sync Odds Player Props"
      }
    },
    "/api/v1/players": {
      "get": {
        "operationId": "list_players_api_v1_players_get",
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          },
          {
            "description": "Comma-separated position whitelist, e.g. QB,RB,WR,TE,FB. The public site passes offensive positions only; defensive/K/P players stay in the DB for future markets but are hidden from browsing.",
            "in": "query",
            "name": "positions",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated position whitelist, e.g. QB,RB,WR,TE,FB. The public site passes offensive positions only; defensive/K/P players stay in the DB for future markets but are hidden from browsing.",
              "title": "Positions"
            }
          },
          {
            "description": "Restrict to players with game activity in the last two seasons. The full table holds 25k historical players going back decades, which is useless to browse on the public site.",
            "in": "query",
            "name": "active_only",
            "required": false,
            "schema": {
              "default": false,
              "description": "Restrict to players with game activity in the last two seasons. The full table holds 25k historical players going back decades, which is useless to browse on the public site.",
              "title": "Active Only",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "include_total",
            "required": false,
            "schema": {
              "default": false,
              "title": "Include Total",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Players",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/players/{player_id}": {
      "get": {
        "operationId": "get_player_api_v1_players__player_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "player_id",
            "required": true,
            "schema": {
              "title": "Player Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Player",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/players/{player_id}/edge_history": {
      "get": {
        "description": "Graded track record for one player: past picks and whether they won.\n\nReads `prop_edge_results`, which joins each historical edge to what the\nplayer actually did in that game (see `services/training/grade_edges.py`).\nThis is what makes a quoted win probability accountable rather than\ndecorative -- the summary compares average predicted win probability against\nthe rate actually achieved.\n\nPushes (actual landed exactly on the line) are stored with `hit = NULL` and\nexcluded from the hit rate, matching how a sportsbook settles them.",
        "operationId": "player_edge_history_api_v1_players__player_id__edge_history_get",
        "parameters": [
          {
            "in": "path",
            "name": "player_id",
            "required": true,
            "schema": {
              "title": "Player Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Player Edge History",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/players/{player_id}/games": {
      "get": {
        "description": "Recent game log for a player (most recent first), from player_game_stats_app.",
        "operationId": "player_games_api_v1_players__player_id__games_get",
        "parameters": [
          {
            "in": "path",
            "name": "player_id",
            "required": true,
