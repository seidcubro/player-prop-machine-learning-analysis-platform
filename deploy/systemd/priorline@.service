# One refresh, in whichever mode the instance names.
#
#   systemctl start priorline@closing
#   systemctl start priorline@daily
#
# The instance is the mode without its dashes, so priorline@weekly runs
# `scheduled_update.sh --weekly`.
#
# Credits are opt-in per mode through /etc/priorline/<mode>.env, so a mode with
# no file for it cannot spend anything. Only daily.env sets ODDS=1.

[Unit]
Description=PriorLine refresh (%i)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
# Tell somebody when this fails.
#
# Every mode already exits non-zero on failure and systemd already records it,
# which is exactly as useful as it sounds: the odds sync failed at 08:00 on two
# consecutive mornings, both failures were logged correctly, and the first
# anyone knew was noticing a stale line on the site three days later. The
# instance name carries across, so priorline@daily failing starts
# priorline-alert@daily.
OnFailure=priorline-alert@%i.service

[Service]
Type=oneshot
WorkingDirectory=/opt/priorline
# The shared secrets and the Odds key.
EnvironmentFile=/etc/priorline/env
# Per-mode overrides. The leading dash means "skip if absent", so a mode with no
# file simply runs without odds.
EnvironmentFile=-/etc/priorline/%i.env
# Serialised across every mode, not just against itself.
#
# Type=oneshot stops one unit running twice, but priorline@daily,
# priorline@closing and priorline@weekly are different units and systemd will
# happily run them at once. The weekly retrain starts at 01:00 and runs about
# fifty minutes; the closing capture fires at 01:05 and 02:05. Both call
# build_prop_edges.py, which truncates prop_edges and rebuilds it, so an overlap
# is two jobs clearing and refilling the same table at the same time. Running
# two rebuilds by hand did exactly that during development and left the board
# empty.
#
# deploy/run_mode.sh takes that lock and, crucially, tells a timeout apart from
# a failure.
#
# This was `flock -w 3600` directly, and the hour-long wait was the bug. The
# weekly starts at 01:00 on a Tuesday and runs most of an hour; the closing
# capture fires at :05 every hour and wants the same lock. So the 01:05 run
# waited the full hour, gave up at 02:05, exited 1, and systemd paged:
#
#   PriorLine closing failed at 2026-11-03 02:05 EST
#   ...last log line: [2026-11-03 00:07:06] ==> done
#
# No output from the failing run, because the script never started. Two jobs
# correctly declining to run at once, at one in the morning on a Tuesday, with
# no game within a day of kickoff, reported as a failure every week.
#
# run_mode.sh waits, then skips cleanly and says so. A real failure inside the
# script still exits non-zero and still pages.
ExecStart=/bin/sh deploy/run_mode.sh %i
# The weekly retrain is the long one, about an hour. This is a ceiling, not a
# target, and it exists so a wedged run cannot block the next timer forever.
TimeoutStartSec=4h
User=priorline
Group=docker
StandardOutput=append:/var/log/priorline/%i.log
StandardError=append:/var/log/priorline/%i.log

[Install]
WantedBy=multi-user.target
