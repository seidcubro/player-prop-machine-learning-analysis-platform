# Copy to .env and fill in. .env is gitignored and must stay that way -- the
# Odds API key is billed per call.

# ---------------------------------------------------------------- Odds API
# https://the-odds-api.com. Credits are consumed per event per market, and the
# historical archive costs about 10x the live rate.
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_SPORT=americanfootball_nfl
ODDS_API_REGIONS=us
ODDS_API_ODDS_FORMAT=american
# Restricting bookmakers keeps the per-call cost down and matches the three
# books there is line history for.
ODDS_API_BOOKMAKERS=draftkings,fanduel,betmgm

# ---------------------------------------------------------------- API auth
# Shared secret for the four POST endpoints that rewrite the database or spend
# Odds credits. Reads never require it.
#
# Leave this unset and those endpoints return 503, which is the intended
# default: an API on the public internet with unlocked write routes can have its
# Odds quota drained by anyone who finds the URL. Generate one with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The pipeline scripts read it from the environment and send it as X-Admin-Token.
ADMIN_TOKEN=

# ---------------------------------------------------------------- CORS
# Browser origins allowed to call the API, comma separated. Local Vite
# (localhost:5173) is always allowed; this is for the deployed frontend.
#   WEB_ORIGINS=https://priorline.com,https://www.priorline.com
WEB_ORIGINS=

# Vercel gives every preview deployment its own subdomain, so listing them by
# hand is not practical. This matches them by pattern instead. Leave unset if
# only production should reach the API.
#   WEB_ORIGIN_REGEX=https://.*-yourname\.vercel\.app
WEB_ORIGIN_REGEX=

# ---------------------------------------------------------------- frontend
# Read by Vite at build time, so they must be set in the Vercel project settings
# rather than here. Included for reference. The build fails by name if either is
# missing, rather than shipping a site that looks fine and cannot call anything.
#   VITE_API_BASE=https://api.priorline.com/api/v1
#   VITE_SITE_URL=https://priorline.com

# Refuse an odds call once the remaining balance drops below this.
# The client treats an unset value as no floor at all.
ODDS_MIN_CREDITS=500

# ---------------------------------------------------------------- production
# Only deploy/docker-compose.prod.yml reads these. The local stack ignores them,
# which is why they went missing: nothing here fails without them and the
# compose file refuses to start on the server, after the box is already paid for.

# The database password in production. The dev stack hardcodes app/app; a
# public server must not.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# The hostname Caddy answers on and requests a certificate for. The API only,
# not the apex: the frontend lives on Vercel.
#   API_DOMAIN=api.priorline.com
API_DOMAIN=

# Where Let's Encrypt sends expiry warnings. Any address you actually read.
#   ACME_EMAIL=you@example.com
ACME_EMAIL=

# How fast one IP may read. A count and a period, not a bare number: this is a
# `limits` rate string and "120" is not one.
#
# It used to say exactly that. A bare number parses nowhere near startup, it
# parses inside the middleware on the first request, so the API came up, passed
# its own health check and then answered every read with a 500. The API now
# logs the bad value and falls back to 60/minute rather than serving errors,
# but set it correctly.
#
# The board is cheap to serve and cheap to scrape, so this is about keeping one
# client from crowding out everyone else rather than about cost.
READ_RATE_LIMIT=120/minute

# Serve the interactive docs and the OpenAPI schema, or not. On is a reasonable
# default: the schema is the clearest description of what the API does. It also
# advertises the write endpoints, which are behind ADMIN_TOKEN either way.
#   API_DOCS=off
API_DOCS=on
